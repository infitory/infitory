# Copy this file to ".env" and fill in the two values from your Supabase
# project (Project Settings -> API Keys / Data API). The .env file is never
# committed to Git.

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
VITE_SUPABASE_URL=

# The PUBLIC key ("publishable" key, or the older "anon" key).
# Never put the "secret" / "service_role" key here.
VITE_SUPABASE_KEY=
